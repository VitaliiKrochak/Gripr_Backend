NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
SWAGGER_USERNAME=swagger
SWAGGER_PASSWORD=replace-with-a-strong-password

# Supabase Auth (access-token verification)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Secret of the Supabase "Send SMS" auth hook (Standard Webhooks format)
SUPABASE_SMS_HOOK_SECRET=v1,whsec_replace-with-the-hook-secret

# Supabase Postgres; use the pooler connection string (transaction mode)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# One-time code delivery: Telegram Gateway first, TurboSMS Viber/SMS fallback.
# Leave a token empty to disable that channel.
TELEGRAM_GATEWAY_TOKEN=
TURBOSMS_TOKEN=
TURBOSMS_SENDER=TurboSMS

# Cloudinary image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# LiqPay payments
LIQPAY_PUBLIC_KEY=sandbox_i00000000000
LIQPAY_PRIVATE_KEY=sandbox_replace-with-private-key
LIQPAY_SANDBOX=true
# sha3-256 (current LiqPay scheme) or sha1 (legacy merchant accounts)
LIQPAY_SIGNATURE_ALGORITHM=sha3-256
# Storefront page the customer returns to after paying; ?orderId= is appended
LIQPAY_RESULT_URL=http://localhost:3000/checkout/result
# Public origin of this API; LiqPay posts callbacks to /api/payments/liqpay/callback
PUBLIC_API_URL=https://api.example.com
# Id of the good from LiqPay "РРО → Каса → Товари" printed on fiscal receipts.
# Leave empty to take payments without fiscal receipts (sandbox/staging only).
LIQPAY_RRO_GOOD_ID=

# Nova Poshta address lookup
NOVAPOSHTA_API_KEY=your-novaposhta-api-key
